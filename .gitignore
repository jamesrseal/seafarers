# Build output
frontend/dist/

# SQLite database — tracked: the committed file is the live data. Render copies
# it into place on start; .github/workflows/refresh-data.yml commits it daily.
!backend/data/
backend/data/*.json
backend/data/*.db-shm
backend/data/*.db-wal

# Bluesky poster output (uploaded as a workflow artifact, never committed)
bluesky/draft.json

# Playwright debug artifacts
scraper/page_*.html
scraper/scraped_*.json

# OS
.DS_Store
