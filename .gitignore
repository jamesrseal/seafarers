/venv/
/old/

# Node
node_modules/
backend/node_modules/
frontend/node_modules/
scraper/node_modules/

# Build output
frontend/dist/

# SQLite database — tracked: the committed file is the live data. Render copies
# it into place on start; .github/workflows/refresh-data.yml commits it daily.
!backend/data/
backend/data/*.json
backend/data/*.db-shm
backend/data/*.db-wal

# Bluesky poster output (uploaded as a workflow artifact, never committed)
bluesky/draft.json

# OpenStreetMap tiles the basemap baker has already fetched. Keeping them makes
# redrawing the panels free, but they are OSM's to serve, not ours to ship: the
# committed artefact is backend/assets/basemaps.
backend/.tile-cache/

# Playwright debug artifacts
scraper/page_*.html
scraper/scraped_*.json

# Agent worktrees: isolated checkouts of this repo. Their commits live on
# branches, so nothing here needs tracking — and committing one would add a
# second copy of the whole repo.
.claude/worktrees/

# OS
.DS_Store
